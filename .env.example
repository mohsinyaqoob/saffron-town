# ─────────────────────────────────────────────────────────────────────────────
# Saffron Town — environment variables.
#
# Local dev: copy to `.env.local` and fill in.
# Production: set these in the Vercel dashboard (Project → Settings →
# Environment Variables). Never commit real values.
#
# NEXT_PUBLIC_* are inlined into the client bundle at BUILD time — changing one
# requires a redeploy, not just a restart. Everything else is read at runtime.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──
# Also required at BUILD time: the build runs `prisma migrate deploy`.
DATABASE_URL=postgresql://user:password@host:5432/saffron

# ── Public / build-time (safe to expose — they ship in the client bundle) ──
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-19
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxx
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Meta Pixel (browser). Falls back to the hardcoded id if unset.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=1030140699881688

# ── Meta Conversions API (server-side events) ──
# SECRET — must NOT be prefixed with NEXT_PUBLIC_.
# Dataset/Pixel id is the same number as the browser pixel above.
META_CAPI_DATASET_ID=1030140699881688
# Events Manager → Settings → Conversions API → Generate access token
# (or a System User token in Business Settings for a long-lived one).
META_CAPI_ACCESS_TOKEN=
# Set ONLY while testing (Events Manager → Test Events). Leave empty in
# production — events sent with this code do not count as real conversions.
META_CAPI_TEST_EVENT_CODE=

# ── Razorpay (server) ──
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=
# Required — the webhook is what triggers the Conversions API Purchase.
RAZORPAY_WEBHOOK_SECRET=

# ── Sanity (server write token — for blog publishing/scripts) ──
SANITY_API_WRITE_TOKEN=
SANITY_DEFAULT_AUTHOR_ID=
SANITY_DEFAULT_IMAGE_ASSET_REF=

# ── Dashboard auth ──
DASHBOARD_USERNAME=pick-a-non-obvious-username
DASHBOARD_PASSWORD=change-me-strong-dashboard-password
DASHBOARD_AUTH_SECRET=change-me-at-least-16-chars-random
ORDER_RECEIPT_SECRET=change-me-random

# ── Cron (serviceability sweep — see vercel.json) ──
CRON_SECRET=change-me-random

# ── Email / SMTP (order + bulk-enquiry notifications) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ORDER_NOTIFY_EMAIL=
ORDER_NOTIFY_FROM=
BULK_ENQUIRY_NOTIFY_EMAIL=
BULK_ENQUIRY_FROM=
BULK_ENQUIRY_BCC=

# ── Misc ──
SHOP_LIVE_FEED_ENABLED=

# ── Freedom Sale (25% coupon: FREEDOM25) ──
# Disabled unless set to exactly "true". Gates the product-page countdown badge,
# the Claim Offer button, the checkout coupon promotion, AND server-side coupon
# redemption — with this off, a request carrying FREEDOM25 is billed full price.
# Server-only on purpose: never expose it as NEXT_PUBLIC_, or the browser
# becomes the authority on whether the discount exists.
FREEDOM_SALE_ENABLED=false
# When the sale closes (ISO 8601). Drives the countdown and is enforced on
# redemption, so the timer can never promise what checkout would refuse.
FREEDOM_SALE_ENDS_AT=2026-08-15T23:59:59+05:30

# ── WhatsApp Cloud API (scripts/send-whatsapp.ts) ──
# From developers.facebook.com → your app → WhatsApp → API Setup.
# Use a permanent System User token, not the 24-hour test token.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANG=en
